# Copy this file to .env and fill in your own Alpaca PAPER trading keys.
# Get these from https://app.alpaca.markets/ under Paper Trading > API Keys.
# Never commit the real .env file (it is already in .gitignore).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Reddit API app credentials for src/collectors/reddit_collector.py.
# See README "Reddit API setup" for how to create these under your own Reddit
# account. Until these are set, the collector automatically falls back to
# Reddit's public (unauthenticated, more rate-limited) JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=llm-trading-tracker/0.1 (by u/your-reddit-username)

# Alpaca LIVE (real money) keys - separate from the paper keys above on
# purpose, so both can sit in .env without either one accidentally being used
# for the wrong mode. Get these from the LIVE section of your Alpaca
# dashboard (requires a funded, identity-verified brokerage account, not the
# paper sandbox). Leave blank until you have actually decided to go live -
# see README "Going live" for the full checklist. Filling these in does
# NOT by itself enable live trading - that also requires --live AND
# LIVE_TRADING_CONFIRM, see below.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Only ever set this on the command line for a single run, never in this
# file: LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_IS_REAL_MONEY
# Leaving it out of .env entirely means --live always fails closed by default.
