# Copy this file to .env and fill in your own Alpaca PAPER trading keys.
# Get these from https://app.alpaca.markets/ under Paper Trading > API Keys.
# Never commit the real .env file (it is already in .gitignore).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Reddit API app credentials for src/collectors/reddit_collector.py.
# See README "Reddit API setup" for how to create these under your own Reddit
# account. Until these are set, the collector automatically falls back to
# Reddit's public (unauthenticated, more rate-limited) JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=llm-trading-tracker/0.1 (by u/your-reddit-username)
